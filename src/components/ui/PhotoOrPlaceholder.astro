---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import PhotoPlaceholder from "./PhotoPlaceholder.astro";

/**
 * Shows a real photo once the owner supplies one, otherwise a labelled placeholder
 * describing the photo needed. Size/shape come from `class` (e.g. aspect ratio, radius).
 */
interface Props {
  image?: ImageMetadata;
  /** Required with `image`. */
  alt?: string;
  /** Instructions shown until the photo exists. */
  placeholder: string;
  placeholderTone?: "light" | "dark";
  /** Candidate widths; the photo's full original width is always added so big/retina screens stay sharp. */
  widths?: number[];
  /** How wide the photo is drawn. For object-cover crops this is the rendered width of the image, not the box. */
  sizes?: string;
  /** Encoding quality (1–100). People photos need more than the default to keep faces crisp. */
  quality?: number;
  /** Which part of the photo stays in view when the box crops it (object-position). */
  focus?: "center" | "top" | "bottom";
  class?: string;
}

const {
  image,
  alt = "",
  placeholder,
  placeholderTone = "light",
  widths = [400, 640, 960, 1280],
  sizes = "(min-width: 1024px) 50vw, 100vw",
  quality = 85,
  focus = "center",
  class: className,
} = Astro.props;

const focusClasses = {
  center: "object-center",
  top: "object-top",
  bottom: "object-bottom",
};

// Never upscale: keep candidates below the original, then offer the original width itself.
const candidates = image
  ? [...widths.filter((w) => w < image.width), image.width]
  : widths;
---

{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="jpg"
    widths={candidates}
    quality={quality}
    sizes={sizes}
    loading="lazy"
    decoding="async"
    class:list={["object-cover", focusClasses[focus], className]}
  />
) : (
  <PhotoPlaceholder
    text={placeholder}
    tone={placeholderTone}
    class={className}
  />
)}
