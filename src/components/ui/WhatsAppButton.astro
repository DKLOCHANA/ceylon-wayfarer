---
import { site } from "@/config/site";
import { buildWhatsAppLink } from "@/lib/whatsapp";
import Button, { type ButtonSize, type ButtonVariant } from "./Button.astro";

interface Props {
  /** Prefilled message; name the route where relevant. */
  message?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  fullWidth?: boolean;
  /** Show the chat icon (default true). */
  icon?: boolean;
  class?: string;
}

const {
  message = site.messages.general,
  variant = "primary",
  size = "md",
  fullWidth,
  icon = true,
  class: className,
} = Astro.props;
const hasLabel = Astro.slots.has("default");
// size="icon" shows only the chat icon, so the label moves to aria-label.
const iconOnly = size === "icon";
---

<Button
  href={buildWhatsAppLink(message)}
  external
  icon={icon ? "whatsapp" : undefined}
  variant={variant}
  size={size}
  fullWidth={fullWidth}
  class={className}
  aria-label={iconOnly ? site.ui.whatsappCta : undefined}
>
  {!iconOnly && (hasLabel ? <slot /> : site.ui.whatsappCta)}
</Button>
