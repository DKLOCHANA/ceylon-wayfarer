---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Button from "./Button.astro";
import Chip from "./Chip.astro";

/** Photo card linking to an itinerary (or any multi-day trip). */
interface Props {
  image: ImageMetadata;
  alt: string;
  /** e.g. "7 DAYS · 6 NIGHTS" */
  meta: string;
  title: string;
  summary: string;
  href: string;
  cta: string;
  class?: string;
}

const {
  image,
  alt,
  meta,
  title,
  summary,
  href,
  cta,
  class: className,
} = Astro.props;
---

<article
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-tile border border-line bg-surface",
    className,
  ]}
>
  <div class="relative aspect-4/3 overflow-hidden bg-primary">
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[360, 540, 720]}
      sizes="(min-width: 1280px) 300px, (min-width: 640px) 50vw, 100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 size-full object-cover transition-transform duration-900 ease-zoom group-hover:scale-106"
    />
    <Chip variant="accent" size="sm" class="absolute top-3 left-3">
      {meta}
    </Chip>
  </div>
  <div class="flex grow flex-col gap-2.5 p-5">
    <h3 class="m-0 font-display text-title-xs leading-title font-extrabold tracking-title">
      {title}
    </h3>
    <p class="m-0 grow text-sm leading-copy text-body">{summary}</p>
    <Button href={href} variant="dark" size="sm" class="self-start">
      {cta}
    </Button>
  </div>
</article>
