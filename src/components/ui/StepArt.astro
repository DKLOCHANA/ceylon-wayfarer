---
/**
 * Small vector illustrations for the "How it works" steps.
 * Inline SVG in brand colours, with gentle looping motion (stops with reduced motion).
 */
export type StepArtName = "plan" | "price" | "ride";

interface Props {
  name: StepArtName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={[
    "overflow-hidden rounded-tile border border-line bg-ground",
    className,
  ]}
>
  <svg
    viewBox="0 0 160 160"
    class="block size-full"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >
    {name === "plan" && (
      <>
        {/* calendar */}
        <rect
          x="16"
          y="74"
          width="40"
          height="40"
          rx="8"
          class="fill-surface stroke-primary"
          stroke-width="2.5"
        />
        <path
          d="M16 82a8 8 0 0 1 8-8h24a8 8 0 0 1 8 8v5H16z"
          class="fill-primary"
        />
        <rect x="24" y="94" width="6" height="6" rx="1.5" class="fill-dash" />
        <rect x="33" y="94" width="6" height="6" rx="1.5" class="fill-dash" />
        <rect x="42" y="94" width="6" height="6" rx="1.5" class="fill-dash" />
        <rect x="24" y="103" width="6" height="6" rx="1.5" class="fill-dash" />
        <rect
          x="33"
          y="103"
          width="6"
          height="6"
          rx="1.5"
          class="fill-accent"
        />
        {/* phone */}
        <rect
          x="52"
          y="20"
          width="64"
          height="120"
          rx="14"
          class="fill-primary"
        />
        <rect x="58" y="32" width="52" height="96" rx="6" class="fill-ground" />
        <rect
          x="74"
          y="25"
          width="20"
          height="3"
          rx="1.5"
          class="fill-on-dark-muted"
        />
        {/* incoming message */}
        <rect
          x="63"
          y="40"
          width="34"
          height="18"
          rx="9"
          class="fill-surface stroke-line"
          stroke-width="1.5"
        />
        <rect
          x="70"
          y="47.5"
          width="20"
          height="3"
          rx="1.5"
          class="fill-dash"
        />
        {/* your reply, being typed */}
        <rect x="70" y="66" width="34" height="18" rx="9" class="fill-accent" />
        <circle cx="80" cy="75" r="2.5" class="art-typing fill-ink" />
        <circle
          cx="87"
          cy="75"
          r="2.5"
          class="art-typing art-delay-1 fill-ink"
        />
        <circle
          cx="94"
          cy="75"
          r="2.5"
          class="art-typing art-delay-2 fill-ink"
        />
        <rect
          x="63"
          y="92"
          width="26"
          height="16"
          rx="8"
          class="fill-surface stroke-line"
          stroke-width="1.5"
        />
        {/* map pin */}
        <ellipse cx="124" cy="134" rx="9" ry="2.5" class="fill-ink/15" />
        <g class="art-hop">
          <path
            d="M124 86c-9 0-16 7-16 16 0 11 16 26 16 26s16-15 16-26c0-9-7-16-16-16z"
            class="fill-accent stroke-ink"
            stroke-width="2"
          />
          <circle cx="124" cy="102" r="6" class="fill-ink" />
        </g>
      </>
    )}
    {name === "price" && (
      <>
        {/* sparkles */}
        <path
          d="M28 34l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5z"
          class="art-pulse fill-accent"
        />
        <path
          d="M132 118l2 4.5 4.5 2-4.5 2-2 4.5-2-4.5-4.5-2 4.5-2z"
          class="art-pulse art-delay-3 fill-primary/40"
        />
        {/* string */}
        <path
          d="M50 82C36 62 40 36 62 26"
          class="stroke-primary"
          stroke-width="2.5"
        />
        {/* swinging price tag */}
        <g class="art-swing">
          <path
            d="M58 58h58a10 10 0 0 1 10 10v28a10 10 0 0 1-10 10H58L36 82z"
            class="fill-accent stroke-ink"
            stroke-width="2.5"
          />
          <circle
            cx="50"
            cy="82"
            r="4.5"
            class="fill-surface stroke-ink"
            stroke-width="2"
          />
          <rect x="66" y="71" width="44" height="8" rx="4" class="fill-ink" />
          <rect
            x="66"
            y="86"
            width="28"
            height="5"
            rx="2.5"
            class="fill-ink/35"
          />
        </g>
        {/* agreed */}
        <g class="art-pop">
          <circle cx="122" cy="48" r="16" class="fill-primary" />
          <path
            d="M114 48l5.5 5.5L131 42"
            class="stroke-ground"
            stroke-width="3.5"
          />
        </g>
      </>
    )}
    {name === "ride" && (
      <>
        {/* sun and hills */}
        <circle cx="122" cy="40" r="15" class="art-pulse fill-accent" />
        <path d="M0 112q34-42 70-14t90-12v74H0z" class="fill-primary/15" />
        <path d="M0 120q50-26 100-6t60-6v52H0z" class="fill-primary/25" />
        {/* road, moving */}
        <rect x="0" y="126" width="160" height="34" class="fill-ink" />
        <path
          d="M-10 144h180"
          class="art-road stroke-ground"
          stroke-width="2.5"
          stroke-dasharray="10 10"
        />
        {/* speed lines */}
        <path
          d="M8 100h14M2 110h18"
          class="art-speed stroke-primary/50"
          stroke-width="2.5"
        />
        {/* the van */}
        <g class="art-bob">
          <path
            d="M30 96a10 10 0 0 1 10-10h58l18 16a10 10 0 0 1 4 8v14a6 6 0 0 1-6 6H36a6 6 0 0 1-6-6z"
            class="fill-surface stroke-ink"
            stroke-width="2.5"
          />
          <path
            d="M31 114h88"
            class="stroke-primary"
            stroke-width="5"
            stroke-linecap="butt"
          />
          <rect
            x="40"
            y="92"
            width="18"
            height="12"
            rx="3"
            class="fill-primary"
          />
          <rect
            x="62"
            y="92"
            width="18"
            height="12"
            rx="3"
            class="fill-primary"
          />
          <path d="M84 92h14l11 10H84z" class="fill-primary" />
          <rect
            x="113"
            y="105"
            width="6"
            height="4"
            rx="1"
            class="fill-accent"
          />
          <circle
            cx="50"
            cy="128"
            r="8"
            class="fill-ink stroke-ground"
            stroke-width="2.5"
          />
          <circle cx="50" cy="128" r="2.5" class="fill-ground" />
          <circle
            cx="102"
            cy="128"
            r="8"
            class="fill-ink stroke-ground"
            stroke-width="2.5"
          />
          <circle cx="102" cy="128" r="2.5" class="fill-ground" />
        </g>
      </>
    )}
  </svg>
</div>
