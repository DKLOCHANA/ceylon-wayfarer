---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { site } from "@/config/site";
import defaultOgImage from "@/assets/images/hero.jpg";

interface Props {
  title: string;
  description: string;
  /** Social share image; defaults to the hero photo, cropped to 1200×630. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
}

const {
  title,
  description,
  image = defaultOgImage,
  imageAlt,
  type = "website",
} = Astro.props;

const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const og = await getImage({
  src: image,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const ogUrl = new URL(og.src, base).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
