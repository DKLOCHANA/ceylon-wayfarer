---
import { getImage } from "astro:assets";
import { site } from "@/config/site";
import { isPlaceholder, realUrl } from "@/lib/format";
import heroImage from "@/assets/images/hero.jpg";

/** JSON-LD LocalBusiness with only true details: placeholder values are left out. */
const base = Astro.site ?? new URL(site.url);
const image = await getImage({ src: heroImage, width: 1200, format: "jpg" });
const phone = site.contact.whatsappNumber.replace(/\D/g, "");

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.name,
  description: site.description,
  url: new URL(import.meta.env.BASE_URL, base).href,
  image: new URL(image.src, base).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.location.town,
    addressCountry: site.location.countryCode,
  },
  areaServed: { "@type": "Country", name: site.location.country },
  knowsLanguage: site.owner.languages,
  ...(!isPlaceholder(site.contact.whatsappNumber) && phone
    ? { telephone: `+${phone}` }
    : {}),
  ...(!isPlaceholder(site.contact.email) ? { email: site.contact.email } : {}),
  ...(() => {
    const sameAs = site.socials
      .map((s) => realUrl(s.url))
      .filter((u): u is string => Boolean(u));
    return sameAs.length ? { sameAs } : {};
  })(),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
