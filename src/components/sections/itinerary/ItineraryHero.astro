---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Chip from "@/components/ui/Chip.astro";

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  breadcrumb: { label: string; current: string };
  title: string;
  summary: string;
  days: number;
  nights: number;
  distanceKm: number;
  /** e.g. "Airport to airport"; omitted when the trip starts and ends elsewhere. */
  endpoints?: string;
  /** e.g. "Best: December–April" */
  best: string;
}

const {
  image,
  imageAlt,
  breadcrumb,
  title,
  summary,
  days,
  nights,
  distanceKm,
  endpoints,
  best,
} = Astro.props;
---

<!-- Full-bleed like the home hero; the frosted header floats over the top of the photo. -->
<section class="tone-dark">
  <div class="relative flex min-h-hero items-end overflow-hidden bg-primary pt-48 sm:pt-40 md:pt-32">
    <Picture
      src={image}
      alt={imageAlt}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      priority
      class="absolute inset-0 size-full animate-ken-burns object-cover"
    />
    <div aria-hidden="true" class="scrim-hero absolute inset-0"></div>

    <div class="relative mx-auto box-border flex w-full max-w-7xl flex-col gap-5.5 px-gutter py-hero-pad text-white">
      <nav
        aria-label="Breadcrumb"
        class="enter-0 font-mono text-xs tracking-label text-on-dark-body"
      >
        <span>{breadcrumb.label}</span>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{breadcrumb.current}</span>
      </nav>
      <h1 class="enter-1 m-0 max-w-title font-display text-display font-extrabold">
        {title}
      </h1>
      <p class="enter-2 m-0 max-w-171 text-lead leading-normal text-on-photo">
        {summary}
      </p>
      <ul class="enter-3 m-0 flex list-none flex-wrap gap-2.5 p-0">
        <Chip as="li" variant="photo">
          <strong class="font-semibold">{days}</strong> days ·{" "}
          <strong class="font-semibold">{nights}</strong> nights
        </Chip>
        <Chip as="li" variant="photo">
          ≈{" "}
          <strong class="font-semibold">
            {distanceKm.toLocaleString("en-US")}
          </strong>{" "}
          km
        </Chip>
        {endpoints && (
          <Chip as="li" variant="photo">
            {endpoints}
          </Chip>
        )}
        <Chip as="li" variant="accent">
          {best}
        </Chip>
      </ul>
    </div>
  </div>
</section>
