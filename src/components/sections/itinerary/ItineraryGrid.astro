---
import type { ImageMetadata } from "astro";
import { revealDelay } from "@/lib/motion";
import ItineraryCard from "@/components/ui/ItineraryCard.astro";
import Section from "@/components/ui/Section.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

export interface ItineraryCardData {
  href: string;
  image: ImageMetadata;
  alt: string;
  meta: string;
  title: string;
  summary: string;
}

/** Heading + grid of itinerary cards. Used for "More itineraries" and the /itineraries list. */
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  intro?: string;
  /** 1 when this is the page title (the /itineraries list). */
  level?: 1 | 2;
  cards: ItineraryCardData[];
  cta: string;
  /** Hairline divider above the section. */
  divider?: boolean;
}

const {
  id = "more-itineraries",
  eyebrow,
  title,
  intro,
  level = 2,
  cards,
  cta,
  divider = false,
} = Astro.props;
---

<Section
  id={id}
  bordered={divider ? "top" : "none"}
  innerClass="flex flex-col gap-10"
>
  <SectionHeading
    eyebrow={eyebrow}
    title={title}
    intro={intro}
    layout="stack"
    size="h2-sm"
    level={level}
  />
  <ul class="grid-auto-fit m-0 list-none gap-5 p-0">
    {cards.map((card, i) => (
      <li class:list={["reveal", revealDelay(i)]}>
        <ItineraryCard {...card} cta={cta} />
      </li>
    ))}
  </ul>
</Section>
