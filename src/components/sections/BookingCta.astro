---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { mailtoLink } from "@/lib/format";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import WhatsAppButton from "@/components/ui/WhatsAppButton.astro";

interface Props {
  id?: string;
  image: ImageMetadata;
  imageAlt: string;
  eyebrow: string;
  title: string;
  lead: string;
  whatsappLabel: string;
  emailLabel: string;
  /** The email button is shown only once a real address is set. */
  email: string;
}

const {
  id = "book",
  image,
  imageAlt,
  eyebrow,
  title,
  lead,
  whatsappLabel,
  emailLabel,
  email,
} = Astro.props;
const mailto = mailtoLink(email);
---

<section id={id} class="tone-dark box-border bg-deep p-3.5">
  <div class="relative flex min-h-cta items-center justify-center overflow-hidden rounded-frame bg-primary">
    <Picture
      src={image}
      alt={imageAlt}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 size-full animate-ken-burns object-cover"
    />
    <div aria-hidden="true" class="absolute inset-0 bg-scrim/62"></div>

    <div class="relative flex flex-col items-center gap-6.5 px-gutter py-20 text-center text-white">
      <Eyebrow tone="accent" class="reveal">
        {eyebrow}
      </Eyebrow>
      <h2 class="reveal-zoom m-0 font-display text-cta font-extrabold">
        {title}
      </h2>
      <p class="reveal reveal-delay-1 m-0 max-w-142 text-lead leading-copy text-on-photo">
        {lead}
      </p>
      <div class="reveal reveal-delay-2 flex flex-wrap justify-center gap-3">
        <WhatsAppButton size="lg">{whatsappLabel}</WhatsAppButton>
        {mailto && (
          <Button href={mailto} variant="ghost-on-photo" size="lg">
            {emailLabel}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
